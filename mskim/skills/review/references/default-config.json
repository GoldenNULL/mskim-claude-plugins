{
  "claude": {
    "enabled": true,
    "model": "opus",
    "effort": "medium"
  },
  "validator_batch_max": 20,
  "vendors": {
    "codex": {
      "enabled": true,
      "model": "",
      "effort": "medium",
      "perspectives": "all",
      "split": false,
      "timeout_sec": 1200,
      "project_config_dir": ".codex",
      "command": "cd {repo} && codex exec -s read-only --skip-git-repo-check --ephemeral {model_flag} {effort_flag} --output-schema {schema} -o {out} - < {prompt}",
      "model_flag": "-m {model}",
      "effort_flag": "-c model_reasoning_effort=\"{effort}\""
    },
    "gemini": {
      "enabled": true,
      "model": "",
      "perspectives": "all",
      "split": false,
      "timeout_sec": 1200,
      "project_config_dir": ".gemini",
      "command": "cd {isolated} && gemini --skip-trust --include-directories {repo} -o json {model_flag} -p \"Follow the review instructions given on stdin.\" < {prompt} > {out}",
      "model_flag": "-m {model}"
    }
  }
}

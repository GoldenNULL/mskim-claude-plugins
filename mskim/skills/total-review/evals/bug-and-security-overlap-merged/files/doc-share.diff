diff --git a/src/docs/permissions.ts b/src/docs/permissions.ts
--- a/src/docs/permissions.ts
+++ b/src/docs/permissions.ts
@@ -1,5 +1,8 @@
+import { db } from "../db";
 import type { Doc, User } from "./types";
 
-export function canEdit(user: User, doc: Doc): boolean {
-  return doc.ownerId === user.id;
+export async function canEdit(user: User, doc: Doc): Promise<boolean> {
+  if (doc.ownerId === user.id) return true;
+  const share = await db.shares.find({ docId: doc.id, userId: user.id });
+  return share?.role === "editor";
 }
diff --git a/src/routes/docs.ts b/src/routes/docs.ts
new file mode 100644
--- /dev/null
+++ b/src/routes/docs.ts
@@ -0,0 +1,14 @@
+import { Router } from "express";
+import { requireAuth } from "../middleware/auth";
+import { canEdit } from "../docs/permissions";
+import { docRepo } from "../repos/docRepo";
+
+export const router = Router();
+
+router.delete("/docs/:id", requireAuth, async (req, res) => {
+  const doc = await docRepo.findById(req.params.id);
+  if (!doc) return res.status(404).end();
+  if (!canEdit(req.user, doc)) return res.status(403).end();
+  await docRepo.delete(doc.id);
+  res.status(204).end();
+});
